---
interface Props {
  class?: string;
  variant?: 'outer' | 'inner' | 'default';
}

const { class: className = '', variant = 'default' } = Astro.props;
---

{
  variant === 'outer' && (
    <div class:list={['sm:px-8', className]}>
      <div class="mx-auto w-full max-w-7xl lg:px-8">
        <slot />
      </div>
    </div>
  )
}

{
  variant === 'inner' && (
    <div class:list={['relative px-4 sm:px-8 lg:px-12', className]}>
      <div class="mx-auto max-w-2xl lg:max-w-5xl">
        <slot />
      </div>
    </div>
  )
}

{
  variant === 'default' && (
    <div class:list={['sm:px-8', className]}>
      <div class="mx-auto w-full max-w-7xl lg:px-8">
        <div class="relative px-4 sm:px-8 lg:px-12">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <slot />
          </div>
        </div>
      </div>
    </div>
  )
}
