---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---

<BaseLayout
  title="404 - pwningcode"
  description="The page you’re looking for isn’t here."
  noindex
>
  <Container class="mt-24 sm:mt-32">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-base font-semibold text-teal-500 dark:text-teal-400">
        404
      </p>
      <h1
        class="mt-4 text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100"
      >
        Page not found.
      </h1>
      <p class="mt-4 text-base text-zinc-600 dark:text-zinc-400">
        Either the page moved, or it was never there. Try the homepage or the
        notes index.
      </p>
      <div class="mt-8 flex justify-center gap-4 text-sm">
        <a
          href="/"
          class="font-medium text-teal-500 hover:text-teal-600 dark:text-teal-400 dark:hover:text-teal-300"
        >
          Home
        </a>
        <span class="text-zinc-300 dark:text-zinc-700">·</span>
        <a
          href="/notes/"
          class="font-medium text-teal-500 hover:text-teal-600 dark:text-teal-400 dark:hover:text-teal-300"
        >
          Notes
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>
